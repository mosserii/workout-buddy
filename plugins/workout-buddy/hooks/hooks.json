{
  "description": "Workout Buddy: the turn hooks (Python, stdlib only) and the band above the prompt (a hooks module).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/wb\" hook-prompt", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/wb\" hook-stop", "timeout": 10 }
        ]
      }
    ]
  },
  "modules": ["./register.js"]
}
